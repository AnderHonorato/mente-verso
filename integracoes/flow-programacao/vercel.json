{
  "buildCommand": "npm ci && npm run provisionar:python && npm run build",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "{servidor,conteudos,executores,aplicativos/web/dist}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "framework": "fastapi"
}
