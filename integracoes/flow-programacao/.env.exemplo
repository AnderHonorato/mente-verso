# Copie para um arquivo local ignorado. Nunca versione valores reais.
DATABASE_URL=sqlite:///./flow.db
# Produção: postgresql+psycopg://usuario:senha@host:5432/flow
CORS_ORIGENS=http://localhost:5173,http://localhost:4173,capacitor://localhost,https://localhost
SESSAO_HORAS=168
# Sem chave: correção responde 503 e preserva tentativa; nunca há chamada automática.
OPENAI_API_KEY=
OPENAI_MODELO=gpt-4.1-mini
# Opcional: pasta absoluta de build web para uma implantação de API + site.
# WEB_DIST=/app/aplicativos/web/dist
PORT=8000

# Em runtime serverless/pooler transacional: BANCO_POOL_NULO=1
BANCO_POOL_NULO=0
# Desative em runtime apenas se CI/release já aplicou migrações antes.
MIGRAR_AO_INICIAR=1
